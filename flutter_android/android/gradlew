#!/bin/sh

APP_HOME=$(cd "$(dirname "$0")" && pwd)
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ -z "$JAVA_HOME" ]; then
  JAVA_CMD="java"
else
  JAVA_CMD="$JAVA_HOME/bin/java"
fi

if ! command -v "$JAVA_CMD" >/dev/null 2>&1; then
  echo "ERROR: JAVA_HOME is not set and no 'java' command could be found." >&2
  exit 1
fi

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Downloading gradle-wrapper.jar..." >&2
  gradle_version=$(grep -o 'gradle-[0-9.]*' "$APP_HOME/gradle/wrapper/gradle-wrapper.properties" | head -n1 | tr -d 'gradle-')
  version="${gradle_version:-8.3}"
  url="https://raw.githubusercontent.com/gradle/gradle/v${version}/gradle/wrapper/gradle-wrapper.jar"
  tmp="$WRAPPER_JAR.tmp"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$url" -o "$tmp" || exit 1
  else
    wget -q "$url" -O "$tmp" || exit 1
  fi
  mv "$tmp" "$WRAPPER_JAR"
fi

exec "$JAVA_CMD" \
  ${JAVA_OPTS:-"-Xmx64m"} \
  -classpath "$WRAPPER_JAR" \
  org.gradle.wrapper.GradleWrapperMain "$@"